#!/usr/bin/env bash
set -euo pipefail
umask 0022

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
ARCH="${ARCH:-"x86_64"}"
DEFAULT_TAG="${DEFAULT_TAG:-"latest"}"
DATESTAMP="${DATESTAMP:-"$(date '+%Y%m%d')"}"
TIMESTAMP="${TIMESTAMP:-"$(date '+%H%M%S')"}"
DATETIMESTAMP="${DATESTAMP}.${TIMESTAMP}"

source "$(dirname -- "${SCRIPT_DIR}")/setup/lib/bash-lib.sh"

prep_metadata() {
    case "${1}" in
        build)
            BUILD_ARGS=(
                "--build-arg" "PRETTY_NAME=${PRETTY_NAME}"
                "--build-arg" "PROJECT_NAME=${PROJECT_NAME}"
                "--build-arg" "PROJECT_VENDOR=${PROJECT_VENDOR}"
                "--build-arg" "PROJECT_SOURCE=${PROJECT_SOURCE}"
                "--build-arg" "PROJECT_README=${PROJECT_README}"
                "--build-arg" "PROJECT_REGISTRY=${PROJECT_REGISTRY}"
                "--build-arg" "MAJOR_VERSION=${MAJOR_VERSION}"
                "--build-arg" "CUSTOM_KERNEL=${CUSTOM_KERNEL}"
                "--build-arg" "TIMEZONE=${TIMEZONE}"
                "--build-arg" "DATESTAMP=${DATESTAMP}"
                "--build-arg" "TIMESTAMP=${TIMESTAMP}"
                "--build-arg" "COMMIT_SHA=${COMMIT_SHA}"
                "--build-arg" "IMAGE_NAME=${IMAGE_NAME}"
                "--build-arg" "BASE_IMAGE=${BASE_IMAGE}"
                "--build-arg" "IMG_FLAVOR=${IMG_FLAVOR}"
            )
            BUILD_LABELS=(
                "--label" "org.opencontainers.image.documentation=${PROJECT_README}"
                "--label" "org.opencontainers.image.source=${PROJECT_SOURCE}"
                "--label" "org.opencontainers.image.created=${DATETIMESTAMP}"
                "--label" "org.opencontainers.image.description=${PROJECT_DESCRP}"
                "--label" "org.opencontainers.image.title=${IMAGE_NAME}"
                "--label" "org.opencontainers.image.vendor=${PROJECT_VENDOR}"
                "--label" "org.opencontainers.image.version=${MAJOR_VERSION}.${DATETIMESTAMP}"
                "--label" "containers.bootc=1"
            )
            for tag in ${BUILD_TAGS}; do
                build_tags+=("--tag" "${IMAGE_NAME}:${tag}")
            done
            ;;
        extra-tags)
            EXTRA_TAGS=(
                "${COMMIT_SHA:0:7}"
                "${MAJOR_VERSION}.${DATESTAMP}"
                "${MAJOR_VERSION}.${DATETIMESTAMP}"
                "${IMG_FLAVOR}"
                "${IMG_FLAVOR}.${DATETIMESTAMP}"
            )
            ;;
        *)
            die "Unknown argument: ${1}"
            ;;
    esac
}

sect_border() {
    symmetric_heading "#" "#" "100" "blue" | tr ' ' '#'
}

build_image() {
    local log_dir="${SCRIPT_DIR}/.log/${IMAGE_NAME}"
    local log_file="${log_dir}/${IMAGE_NAME}.${DATETIMESTAMP}.log"
    local sec_type="${SEC_TYPE:-"id=sbmok_priv,src=${SBMOK_KEY},type=file"}"
    local tag build_tags=() extra_opts=()

    while [[ $# -gt 0 ]]; do
        case "${1}" in
            --extra-opts) shift; extra_opts=("$@"); break ;;
            *)            die "Unknown option: ${1}"      ;;
        esac
    done

    [[ -n "${BASE_IMAGE:-}" ]] || die "Missing BASE IMAGE"
    [[ -n "${IMG_FLAVOR:-}" ]] || die "Missing IMAGE FLAVOR"

    prep_metadata build
    ensure_dir "${log_dir}" >/dev/null
    {
    sect_border
    echo "${green}"  " Building      - ${IMAGE_NAME}:${DEFAULT_TAG}${noc}"
    echo "${purple}" " Base Image    - ${BASE_IMAGE}${noc}"
    echo "${yellow}" " Datestamp     - ${DATETIMESTAMP}${noc}"
    echo "${cyan}"   " Git Commit    - ${COMMIT_SHA}${noc}"
    sect_border

    _cmd_test_timer_start=${EPOCHSECONDS}
    cd "$(dirname -- "${SCRIPT_DIR}")"
    { brief_trace; } 2>/dev/null
    podman build "${extra_opts[@]}" \
                 --pull=newer \
                 --secret "${sec_type}" \
                 --file "Containerfile" \
                 "${BUILD_LABELS[@]}" \
                 "${BUILD_ARGS[@]}" \
                 "${build_tags[@]}" \
                 .
    { brief_trace; } 2>/dev/null
    _cmd_test_timer_end=$(cmd_test_timer)

    sect_border
    echo "${green}"  " Build Done    - ${IMAGE_NAME}:${DEFAULT_TAG}${noc}"
    echo "${purple}" " Build Time    - ${_cmd_test_timer_end}${noc}"
    sect_border
    } \
    2>&1 | perl -MTime::HiRes=gettimeofday -ne '
        $|=1;
        ($s, $usec) = gettimeofday();
        ($sec,$min,$hour,$mday,$mon,$year) = localtime($s);
        printf("[%02d:%02d:%02d.%03d] %s", $hour, $min, $sec, $usec/1000, $_);' \
    2>&1 | tee -a "${log_file}"

    ln -sf "${log_file}" "${log_dir}/${IMAGE_NAME}.last.log"
}

containerized_rpm_ostree() {
    podman run --rm --privileged \
               -v /var/lib/containers:/var/lib/containers \
               --entrypoint /usr/bin/rpm-ostree \
               "${BASE_IMAGE}:${MAJOR_VERSION}" \
               "$@"
}

chunk_image() {
    sect_border
    echo "${green}" " Chunking       - ${IMAGE_NAME}:${DEFAULT_TAG}${noc}"
    sect_border

    [[ -n "${BASE_IMAGE:-}" ]] || die "Missing BASE IMAGE"

    RPM_OSTREE="$(command -v rpm-ostree)" || true
    if [[ ! -x "${RPM_OSTREE:-}" ]]; then
        [[ ${EUID} -ne 0 ]] &&
            die "Root privileges required. Command missing on current system: rpm-ostree"
        RPM_OSTREE="containerized_rpm_ostree"
    fi

    _cmd_test_timer_start=${EPOCHSECONDS}
    { brief_trace; } 2>/dev/null
    ${RPM_OSTREE} compose \
                  build-chunked-oci \
                  --bootc --max-layers 250 --format-version=2 \
                  --from "localhost/${IMAGE_NAME}:${DEFAULT_TAG}" \
                  --output containers-storage:"localhost/${IMAGE_NAME}-chunked:${DEFAULT_TAG}"
    { brief_trace; } 2>/dev/null
    _cmd_test_timer_end=$(cmd_test_timer)

    sect_border
    echo "${green}"  " Chunk Done    - ${IMAGE_NAME}:${DEFAULT_TAG}${noc}"
    echo "${purple}" " Chunk Time    - ${_cmd_test_timer_end}${noc}"
    sect_border
}

push_image() {
    # Always push image without chunked suffix
    local push_image="${IMAGE_NAME/-chunked/}" image_tags="${BUILD_TAGS:-}" tag extra_opts=()
    digestfile="/tmp/${push_image}-digestfile"

    while [[ $# -gt 0 ]]; do
        case "${1}" in
            --image-tags)    image_tags="${2}";        shift 2 ;;
            --registry)      PROJECT_REGISTRY="${2}";  shift 2 ;;
            --extra-opts)    shift; extra_opts=("$@"); break   ;;
            *)               die "Unknown option: ${1}"        ;;
        esac
    done

    [[ -n "${image_tags:-}" ]] || die "Missing push tags"
    [[ -n "${PROJECT_REGISTRY:-}" ]] || die "Missing container registry"

    sect_border
    echo "${green}"  " Pushing       - ${push_image}:${DEFAULT_TAG}${noc}"
    echo "${purple}" " Push Registry - ${PROJECT_REGISTRY}${noc}"
    sect_border

    _cmd_test_timer_start=${EPOCHSECONDS}
    for tag in ${image_tags}; do
        local image_full="${PROJECT_REGISTRY}/${push_image}:${tag}"

        log "INFO" "Pushing: ${push_image}:${tag}"

        { brief_trace; } 2>/dev/null
        podman tag "${IMAGE_NAME}:${DEFAULT_TAG}" "${image_full}"
        podman push --digestfile="${digestfile}" "${extra_opts[@]}" \
                    "${IMAGE_NAME}:${DEFAULT_TAG}" "${image_full}"
        { brief_trace; } 2>/dev/null

        log "INFO" "Pushed: ${push_image}:${tag}"
    done
    _cmd_test_timer_end=$(cmd_test_timer)

    sect_border
    echo "${green}"  " Push Done     - ${IMAGE_NAME}:${DEFAULT_TAG}${noc}"
    echo "${purple}" " Push Time     - ${_cmd_test_timer_end}${noc}"
    sect_border
}

cosign_image() {
    local image_full digestfile="/tmp/${IMAGE_NAME}-digestfile" digest

    while [[ $# -gt 0 ]]; do
        case "${1}" in
            --digestfile) digestfile="${2}";       shift 2 ;;
            --registry)   PROJECT_REGISTRY="${2}"; shift 2 ;;
            *)            die "Unknown option: ${1}"       ;;
        esac
    done

    [[ -f "${digestfile}" ]] || die "Missing digestfile: ${digestfile}"
    [[ -n "${PROJECT_REGISTRY:-}" ]] || die "Missing container registry"
    has_cmd cosign || die "Command missing on current system: cosign"

    image_full="${PROJECT_REGISTRY}/${IMAGE_NAME}"
    digest="$(< "${digestfile}")"

    sect_border
    echo "${green}"  " Signing OCI   - ${IMAGE_NAME}:${DEFAULT_TAG}${noc}"
    echo "${purple}" " Registry      - ${PROJECT_REGISTRY}${noc}"
    sect_border

    { brief_trace; } 2>/dev/null
    COSIGN_EXPERIMENTAL=false \
    cosign sign -y --key env://COSIGN_PRIVATE_KEY "${image_full}@${digest}"
    { brief_trace; } 2>/dev/null

    [[ -f "${digestfile}" ]] && rm "${digestfile}"

    sect_border
    echo "${green}"  " Signing Done  - ${IMAGE_NAME}:${DEFAULT_TAG}${noc}"
    sect_border
}

build_iso() {
    local image_full graphroot output_dir payloadfile extra_opts=()

    while [[ $# -gt 0 ]]; do
        case "${1}" in
            --payloadfile) payloadfile="${2}";        shift 2 ;;
            --payloadonly) payloadonly=1;             shift 1 ;;
            --output-dir)  output_dir="${2}";         shift 2 ;;
            --registry)    PROJECT_REGISTRY="${2}";   shift 2 ;;
            *)             die "Unknown option: ${1}"         ;;
        esac
    done

    [[ -n "${PROJECT_REGISTRY:-}" ]] || die "Missing container registry"
    [[ ${EUID} -eq 0 ]] || die "Root privileges required for ISO build"
    if [[ ${payloadonly:-0} -eq 0 ]]; then
        [[ -n "${output_dir:-}" ]] || die "Missing output directory"
    fi

    image_full="${PROJECT_REGISTRY}/${IMAGE_NAME}:${DEFAULT_TAG}"
    graphroot="$(podman info --format '{{.Store.GraphRoot}}')"

    sect_border
    echo "${green}"  " Payload/ISO   - ${IMAGE_NAME}:${DEFAULT_TAG}${noc}"
    echo "${purple}" " Registry      - ${PROJECT_REGISTRY}${noc}"
    sect_border

    _cmd_test_timer_start=${EPOCHSECONDS}
    # Create payload container
    if [[ -n ${payloadfile:-} ]]; then
        log "INFO" "Creating payload container"
        { brief_trace; } 2>/dev/null
        podman build --pull=newer \
                     --cap-add sys_admin \
                     --security-opt label=disable \
                     --file "${payloadfile}" \
                     --build-arg "IMAGE_NAME=${IMAGE_NAME}" \
                     --build-arg "PROJECT_REGISTRY=${PROJECT_REGISTRY}" \
                     --build-arg "DEFAULT_TAG=${DEFAULT_TAG}" \
                     --tag "${IMAGE_NAME}-payload:${DEFAULT_TAG}"
        { brief_trace; } 2>/dev/null

        # End function here with build stats when payloadonly is set
        if [[ ${payloadonly:-0} -eq 1 ]]; then
            _cmd_test_timer_end=$(cmd_test_timer)
            sect_border
            echo "${green}"  " Built Payload - ${IMAGE_NAME}-payload:${DEFAULT_TAG}${noc}"
            echo "${purple}" " Build Time    - ${_cmd_test_timer_end}${noc}"
            sect_border
            return 0
        fi

        # Use payload image to build iso
        image_full="localhost/${IMAGE_NAME}-payload:${DEFAULT_TAG}"
    fi

    log "INFO" "Building ISO with reference image: ${image_full}"
    ensure_dir "${output_dir}" >/dev/null
    { brief_trace; } 2>/dev/null
    podman run --rm --privileged \
               --net=host --security-opt label=type:unconfined_t \
               -v "${graphroot}:/var/lib/containers/storage" \
               -v "${output_dir}:/output" \
                  ghcr.io/osbuild/image-builder-cli:latest \
                        build --verbose \
                              --bootc-ref "${image_full}" \
                              --bootc-default-fs ext4 bootc-generic-iso
    mv -vf "${output_dir}"/*/*.iso \
           "${output_dir}/${IMAGE_NAME}-${MAJOR_VERSION}.${DATETIMESTAMP}.${ARCH}.iso"
    { brief_trace; } 2>/dev/null
    _cmd_test_timer_end=$(cmd_test_timer)

    sect_border
    echo "${green}"  " Built ISO     - ${IMAGE_NAME}:${DEFAULT_TAG}${noc}"
    echo "${purple}" " Build Time    - ${_cmd_test_timer_end}${noc}"
    sect_border
}

show_help() {
    cat <<EOF
Usage: $(basename -- "${0}") [global_options] command1 [options] [command2 [options] ...

Global Options:
  -h, --help                        Show this help message
  -i, --image-name <name>           Set default image name for all operations
  -b, --base-image <image_url>      Set base image for the build or chunking
  -f, --img-flavor <tag>            Set an image flavor tag for the build

Commands:
  build
        Build the container image using podman
        Options:
            --extra-opts <args>     Additional arguments for podman build

  chunk
        Create a chunked OCI image using rpm-ostree
        Note: Root privileges required when if 'rpm-ostree' command is missing
              Furthermore, later operations (push or cosign) may also require root

  push
        Push the image with tag(s) to a container registry
        Options:
            --image-tags <tags>     Space-separated list of tags to push
            --registry   <url>      Target container registry
            --extra-opts <args>     Additional arguments for podman push

  cosign
        Sign pushed container image using Sigstore
        Options:
            --digestfile <file>     Path to the digest file created during push
            --registry   <url>      Target container registry

  iso
        Builds a bootable ISO installer
        Note: Root privileges required
        Options:
            --payloadfile <file>    Containerfile used to build the payload image
            --payloadonly           Build only the payload image (skips ISO creation)
            --output-dir  <dir>     Directory to save the resulting .iso file
            --registry    <url>     Container registry with the source image

Example:
      $(basename -- "${0}") build chunk push cosign -i my-os -f main -b quay.io/base:latest \
          --registry ghcr.io/me --image-tags latest
EOF
}

# Add values to GITHUB_VARS for later use
gh_hook() {
    local cmd="${1}"
    if [[ -n "${GITHUB_ENV:-}" ]]; then
        case "${cmd}" in
            pre-build)
                # Set key type
                SEC_TYPE="id=sbmok_priv,env=SBMOK_KEY"
                # Extra build tags
                [[ -n "${IMG_FLAVOR:-}" ]] || die "Missing IMAGE FLAVOR"
                prep_metadata extra-tags
                BUILD_TAGS="${BUILD_TAGS} ${EXTRA_TAGS[*]}"
                ;;
            post-build)
                # Add build tags and real image_name to output
                echo "build_tags=${BUILD_TAGS}" >> "${GITHUB_OUTPUT}"
                # Add real image_name
                echo "image_name=${IMAGE_NAME}" >> "${GITHUB_OUTPUT}"
                ;;
            post-chunk)
                # Add chunked image_name
                echo "image_name=${IMAGE_NAME}-chunked" >> "${GITHUB_OUTPUT}"
                ;;
            post-push)
                # Add digestfile for cosign
                echo "digest=$(< "${digestfile}")" >> "${GITHUB_OUTPUT}"
                unset digestfile
                ;;
            post-iso)
                # Add payload image
                echo "payload_image=${IMAGE_NAME}-payload:${DEFAULT_TAG}" >> "${GITHUB_OUTPUT}"
                # Add iso name
                if [[ ${payloadonly:-0} -eq 0 ]]; then
                    echo "iso_name=${IMAGE_NAME}-${MAJOR_VERSION}.${DATETIMESTAMP}.${ARCH}.iso" \
                            >> "${GITHUB_OUTPUT}"
                fi
                unset payloadonly
                ;;
            *)
                return 0
                ;;
        esac
    fi
}

exec_subcommand() {
    local cmd="${1}"; shift
    gh_hook "pre-${cmd}"
    case "${cmd}" in
        build)  build_image  "$@" ;;
        chunk)  chunk_image  "$@" ;;
        push)   push_image   "$@" ;;
        cosign) cosign_image "$@" ;;
        iso)    build_iso    "$@" ;;
        *) die "Unknown command: ${cmd}" show_help ;;
    esac
    gh_hook "post-${cmd}"
}

main() {
    local rem_args arg curr_cmd curr_args

    [[ $# -eq 0 ]] && show_help
    # Iterate through all arguments and capture global flags
    rem_args=()
    while [[ $# -gt 0 ]]; do
        case "${1}" in
            -h|--help)       show_help;          exit  0 ;;
            -i|--image-name) IMAGE_NAME="${2}";  shift 2 ;;
            -b|--base-image) BASE_IMAGE="${2}";  shift 2 ;;
            -f|--img-flavor) IMG_FLAVOR="${2}";  shift 2 ;;
            *)               rem_args+=("${1}"); shift 1 ;;
        esac
    done

    [[ -n "${IMAGE_NAME:-}" ]] || die "Provide image name"

    # Execute subcommands
    for arg in "${rem_args[@]}"; do
        case "${arg}" in
            build|chunk|push|cosign|iso)
                # Execute a subcommand in progress before starting new one
                if [[ -n "${curr_cmd:-}" ]]; then
                    exec_subcommand "${curr_cmd}" "${curr_args[@]}"
                fi
                curr_cmd="${arg}"
                curr_args=()
                ;;
            *)
                # Collect args for active subcommand
                { [[ -n "${curr_cmd:-}" ]] && curr_args+=("${arg}"); } ||
                die "Non glabl flag '${arg}' provided before subcommand"
                ;;
        esac
    done

    # Execute the final subcommand remaining
    if [[ -n "${curr_cmd:-}" ]]; then
        exec_subcommand "${curr_cmd}" "${curr_args[@]}"
    fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
