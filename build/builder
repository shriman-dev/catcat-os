#!/usr/bin/env bash
set -euo pipefail
umask 0022
SCRIPT_DIR="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
source "$(dirname "${SCRIPT_DIR}")/setup/setup_lib/funcvar.sh"

prep_metadata() {
    BUILD_ARGS=(
        "--build-arg" "PRETTY_NAME=${PRETTY_NAME}"
        "--build-arg" "PROJECT_NAME=${PROJECT_NAME}"
        "--build-arg" "PROJECT_VENDOR=${PROJECT_VENDOR}"
        "--build-arg" "PROJECT_SOURCE=${PROJECT_SOURCE}"
        "--build-arg" "PROJECT_README=${PROJECT_README}"
        "--build-arg" "PUSH_REGISTRY=${PUSH_REGISTRY}"
        "--build-arg" "MAJOR_VERSION=${MAJOR_VERSION}"
        "--build-arg" "CUSTOM_KERNEL=${CUSTOM_KERNEL}"
        "--build-arg" "TIMEZONE=${TIMEZONE}"
        "--build-arg" "DATESTAMP=${DATESTAMP}"
        "--build-arg" "TIMESTAMP=${TIMESTAMP}"
        "--build-arg" "COMMIT_SHA=${COMMIT_SHA}"
        "--build-arg" "IMAGE_NAME=${IMAGE_NAME}"
        "--build-arg" "BASE_IMAGE=${BASE_IMAGE}"
        "--build-arg" "ALT_TAG=${ALT_TAG}"
    )

    BUILD_LABELS=(
        "--label" "org.opencontainers.image.documentation=${PROJECT_README}"
        "--label" "org.opencontainers.image.source=${PROJECT_SOURCE}"
        "--label" "org.opencontainers.image.created=${DATETIMESTAMP}"
        "--label" "org.opencontainers.image.description=${PROJECT_DESCRP}"
        "--label" "org.opencontainers.image.title=${IMAGE_NAME}"
        "--label" "org.opencontainers.image.vendor=${PROJECT_VENDOR}"
        "--label" "org.opencontainers.image.version=${MAJOR_VERSION}.${DATETIMESTAMP}"
        "--label" "containers.bootc=1"
    )

    EXTRA_TAGS=(
        "${COMMIT_SHA:0:7}"
        "${MAJOR_VERSION}.${DATESTAMP}"
        "${MAJOR_VERSION}.${DATETIMESTAMP}"
        "${ALT_TAG}"
        "${ALT_TAG}.${DATETIMESTAMP}"
    )
}

sect_border() {
    symmetric_heading "#" "#" "100" "blue" | tr ' ' '#'
}

# SC2154 - variable is referenced but not assigned.
# shellcheck disable=SC2154
build_image() {
    local log_dir="${SCRIPT_DIR}/.log/${IMAGE_NAME}"
    local log_file="${log_dir}/${IMAGE_NAME}.${DATETIMESTAMP}.log"
    local sec_type="${SEC_TYPE:-"id=sbmok_priv,src=${SBMOK_KEY},type=file"}"
    local tag build_tags=()

    for tag in ${BUILD_TAGS}; do
        build_tags+=("--tag" "${IMAGE_NAME}:${tag}")
    done

    ensure_dir "${log_dir}"

    {
    sect_border
    echo "${green}"  " Building      - ${IMAGE_NAME}:${DEFAULT_TAG}${noc}"
    echo "${purple}" " Base Image    - ${BASE_IMAGE}${noc}"
    echo "${yellow}" " Datestamp     - ${DATETIMESTAMP}${noc}"
    echo "${cyan}"   " Git Commit    - ${COMMIT_SHA}${noc}"
    sect_border

    _cmd_test_timer_start=$(date +%s)
    cd "$(dirname "${SCRIPT_DIR}")"
    { brief_trace; } 2>/dev/null
    podman build "$@" \
                 --pull=newer \
                 --dns 9.9.9.9 \
                 --secret "${sec_type}" \
                 --file "Containerfile" \
                 "${BUILD_LABELS[@]}" \
                 "${BUILD_ARGS[@]}" \
                 "${build_tags[@]}" \
                 .
    { brief_trace; } 2>/dev/null
    _cmd_test_timer_end=$(cmd_test_timer)

    sect_border
    echo "${green}"  " Build Done    - ${IMAGE_NAME}:${DEFAULT_TAG}${noc}"
    echo "${purple}" " Build Time    - ${_cmd_test_timer_end}${noc}"
    sect_border
    } \
    2>&1 | \
    perl -MTime::HiRes=gettimeofday -ne '
        $|=1;
        ($s, $usec) = gettimeofday();
        ($sec,$min,$hour,$mday,$mon,$year) = localtime($s);
        printf("[%02d:%02d:%02d.%03d] %s", $hour, $min, $sec, $usec/1000, $_);' \
    2>&1 | tee -a "${log_file}"

    ln -sf "${log_file}" "${log_dir}/${IMAGE_NAME}.last.log"
}

containerized_rpm_ostree() {
    podman run --rm --privileged \
               -v /var/lib/containers:/var/lib/containers \
               --entrypoint /usr/bin/rpm-ostree \
               "${BASE_IMAGE}:${MAJOR_VERSION}" \
               "$@"
}

chunk_image() {
    sect_border
    echo "${green}" " Chunking       - ${IMAGE_NAME}:${DEFAULT_TAG}${noc}"
    sect_border

    _cmd_test_timer_start=$(date +%s)
    { brief_trace; } 2>/dev/null
    ${RPM_OSTREE} compose \
                  build-chunked-oci \
                  --bootc --max-layers 250 \
                  --format-version=2 \
                  --from "localhost/${IMAGE_NAME}:${DEFAULT_TAG}" \
                  --output containers-storage:"localhost/${IMAGE_NAME}-chunked:${DEFAULT_TAG}"
    { brief_trace; } 2>/dev/null
    _cmd_test_timer_end=$(cmd_test_timer)

    sect_border
    echo "${green}"  " Chunk Done    - ${IMAGE_NAME}:${DEFAULT_TAG}${noc}"
    echo "${purple}" " Chunk Time    - ${_cmd_test_timer_end}${noc}"
    sect_border
}

push_image() {
    # Always push image without chunked suffix
    local push_image="${IMAGE_NAME/-chunked/}" push_tags="${BUILD_TAGS}" tag
    digestfile="/tmp/digestfile"

    sect_border
    echo "${green}"  " Pushing       - ${push_image}:${DEFAULT_TAG}${noc}"
    echo "${purple}" " Push Registry - ${PUSH_REGISTRY}${noc}"
    sect_border

    _cmd_test_timer_start=$(date +%s)
    for tag in ${push_tags}; do
        log "INFO" "Pushing: ${push_image}:${tag}"
        { brief_trace; } 2>/dev/null
        podman tag "${IMAGE_NAME}:${DEFAULT_TAG}" "${PUSH_REGISTRY}/${push_image}:${tag}"
        podman push --digestfile="${digestfile}" "$@" \
                    "${IMAGE_NAME}:${DEFAULT_TAG}" "${PUSH_REGISTRY}/${push_image}:${tag}"
        { brief_trace; } 2>/dev/null
        log "INFO" "Pushed: ${push_image}:${tag}"
    done
    _cmd_test_timer_end=$(cmd_test_timer)

    sect_border
    echo "${green}"  " Push Done    - ${IMAGE_NAME}:${DEFAULT_TAG}${noc}"
    echo "${purple}" " Push Time    - ${_cmd_test_timer_end}${noc}"
    sect_border
}

show_help() {
    cat <<EOF
Usage: $(basename "${0}") [global_options] command1 [options] [command2 [options] ...

Global Options:
  -h, --help          Show this help message
  -i, --image-name    Set default image name of build
  -b, --base-image    Set base image to build upon
  -t, --alt-tag       Set an alt tag for image build

Commands:
  build               Build the container image using podman
  chunk               Create a chunked OCI image using rpm-ostree
  push                Push the image with tag(s) to the configured registry

Example:
  $(basename "${0}") build chunk push -i my-image -t main -b quay.io/fedora-ostree-desktops/silverblue
EOF
}

# Add values to GITHUB_VARS for later use
gh_hook() {
    local cmd="${1}"
    if [[ -n "${GITHUB_ENV:-}" ]]; then
        case "${cmd}" in
            pre-build)
                SEC_TYPE="id=sbmok_priv,env=SBMOK_KEY"
                # Add build tags
                BUILD_TAGS="${BUILD_TAGS} ${EXTRA_TAGS[*]}"
                echo "build_tags=${BUILD_TAGS}" >> "${GITHUB_OUTPUT}"
                # Add real image_name
                echo "image_name=${IMAGE_NAME}" >> "${GITHUB_ENV}"
                ;;
            post-chunk)
                # Add chunked image_name
                echo "image_name=${IMAGE_NAME}-chunked" >> "${GITHUB_ENV}"
                ;;
            post-push)
                # Add digestfile for cosign
                echo "digest=$(< "${digestfile}")" >> "${GITHUB_OUTPUT}"
                unset digestfile
                ;;
            *)
                return 0
                ;;
        esac
    fi
}

exec_subcommand() {
    local cmd="${1}"; shift
    gh_hook "pre-${cmd}"
    case "${cmd}" in
        build) build_image "$@" ;;
        chunk) chunk_image "$@" ;;
        push)  push_image  "$@" ;;
        *) die "Unknown command: ${cmd}" show_help ;;
    esac
    gh_hook "post-${cmd}"
}

main() {
    local rem_args arg curr_cmd curr_args

    [[ $# -eq 0 ]] && show_help
    # Iterate through all arguments and capture global flags
    rem_args=()
    while [[ $# -gt 0 ]]; do
        case "${1}" in
            -h|--help)
                show_help;          exit  0 ;;
            -i|--image-name)
                [[ -n "${2:-}" ]] || die "Provide image name"
                IMAGE_NAME="${2}";  shift 2 ;;
            -b|--base-image)
                [[ -n "${2:-}" ]] || die "Provide base image"
                BASE_IMAGE="${2}";  shift 2 ;;
            -t|--alt-tag)
                [[ -n "${2:-}" ]] || die "Provide alt tag"
                ALT_TAG="${2}";     shift 2 ;;
            *)
                rem_args+=("${1}"); shift   ;;
        esac
    done

    RPM_OSTREE="$(command -v rpm-ostree)" || true
    if [[ ! -x "${RPM_OSTREE:-}" ]]; then
        [[ ${EUID} -ne 0 ]] &&
            die "Requires root privileges, rpm-ostree command not found on current system"
        RPM_OSTREE="containerized_rpm_ostree"
    fi

    prep_metadata

    # Execute subcommands
    for arg in "${rem_args[@]}"; do
        case "${arg}" in
            build|chunk|push)
                # Execute a subcommand in progress before starting new one
                if [[ -n "${curr_cmd:-}" ]]; then
                    exec_subcommand "${curr_cmd}" "${curr_args[@]}"
                fi
                curr_cmd="${arg}"
                curr_args=()
                ;;
            *)
                # Collect args for active subcommand
                { [[ -n "${curr_cmd:-}" ]] && curr_args+=("${arg}"); } ||
                die "Non glabl flag '${arg}' provided before subcommand"
                ;;
        esac
    done

    # Execute the final subcommand remaining
    if [[ -n "${curr_cmd:-}" ]]; then
        exec_subcommand "${curr_cmd}" "${curr_args[@]}"
    fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
