#!/usr/bin/env bash
set -euo pipefail
umask 0022
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
LOCALNET_IP="$(hostname -I | tr ' ' '\n' | grep -E '^(10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[0-1])\.)')"
source "$(dirname -- "${SCRIPT_DIR}")/setup/lib/bash-lib.sh"
source "${SCRIPT_DIR}/ENVAR"
#set -x

# Set custom TMP and CACHE directories
export TMPDIR="${TMPDIR:-"/var/tmp/local-build-tmp"}"
mkdir -p "${TMPDIR}"
if [[ -n "${PERSISTENT_CACHE_DIR:-}" ]]; then
    ln -Tvsf "${PERSISTENT_CACHE_DIR}" "${TMPDIR}/buildah-cache-${UID}"
fi

BUILD_TARGETS=()
[[ $# -eq 0 ]] && die "No option provided"
while [[ $# -gt 0 ]]; do
    case "${1}" in
        --chunk-img)
            CHUNK_IMAGE=1
            ;;
        --local-reg)
            LOCAL_REGISTRY=1
            LOCAL_REGISTRY_ADR="127.0.0.1:5000"
            LOCALNET_REGISTRY_ADR="${LOCALNET_IP}:5000"
            ;;
        --build-skp) # Skip building image and proceed to chunking or pushing
            BUILD_SKIP=1
            ;;
        --build-img) # Build specified image(s) (defaults to all builds)
            shift
            BUILD_TARGETS=("$@")
            [[ ${#BUILD_TARGETS[@]} -eq 0 ]] && die "No image specified"
            break
            ;;
        *)
            die "Unknown argument: ${1}"
            ;;
    esac
    shift
done

# Set local container registry
# This is useful for building images completely without root privileges
# Switch to locally built image with command:
# sudo bootc switch 127.0.0.1:5000/catcat-os:latest
local_registry() {
    local registries_confd reg_status local_registry_dir
    registries_confd="/etc/containers/registries.conf.d"

    if [[ ! -f "${registries_confd}/local-registry.conf" ]]; then
        echo "[[registry]]
location = \"${LOCAL_REGISTRY_ADR}\"
insecure = true" | sudo tee "${registries_confd}/local-registry.conf"
        echo "[[registry]]
location = \"${LOCALNET_REGISTRY_ADR}\"
insecure = true" | sudo tee "${registries_confd}/localnet-registry.conf"
        sudo chmod -v 644 "${registries_confd}"/*
    fi

    # Run local container registry server
    reg_status="$(podman inspect -f "{{.State.Running}}" local-registry)" || true
    local_registry_dir="${LOCAL_REGISTRY_DIR:-"${HOME}/.local/share/containers/local-registry"}"

    if [[ "${reg_status:-false}" == "false" ]]; then
        log "INFO" "Running local container registry in background"
        ensure_dir "${local_registry_dir}"
        podman run --name local-registry \
                   --pull=missing --detach \
                   -p "${LOCAL_REGISTRY_ADR}:5000" \
                   -p "${LOCALNET_REGISTRY_ADR}:5000" \
                   -v "${local_registry_dir}:/var/lib/registry:Z" \
                   --replace --restart unless-stopped \
                   registry:2
    fi
}
if [[ ${LOCAL_REGISTRY:-} -eq 1 ]]; then
    local_registry
fi

# Define builds
declare -A BUILDS=(
    [catcat-os]="main|quay.io/fedora-ostree-desktops/silverblue"
    [catcat-os-nv]="nvidia|localhost/catcat-os"
    [catcat-os-hh]="deck|localhost/catcat-os"
)

# If no build target specified, build all images in BUILDS array
if [[ ${#BUILD_TARGETS[@]} -eq 0 ]]; then
    BUILD_TARGETS=("${!BUILDS[@]}")
fi

builder() { "${SCRIPT_DIR}/builder" "$@"; }
for IMAGE_NAME in "${BUILD_TARGETS[@]}"; do
    if [[ -z "${BUILDS["${IMAGE_NAME}"]:-}" ]]; then
        die "Variant '${IMAGE_NAME}' not found in BUILDS array"
    fi

    IFS='|' read -r IMG_FLAVOR BASE_IMAGE <<< "${BUILDS["${IMAGE_NAME}"]}"
    if [[ ${BUILD_SKIP:-} -ne 1 ]]; then
        builder build --image-name "${IMAGE_NAME}" \
                      --base-image "${BASE_IMAGE}" \
                      --img-flavor "${IMG_FLAVOR}"
    fi

    if [[ ${CHUNK_IMAGE:-} -eq 1 ]]; then
        builder chunk --image-name "${IMAGE_NAME}" \
                      --base-image "${BASE_IMAGE}"
        IMAGE_NAME="${IMAGE_NAME}-chunked"
    fi

    if [[ ${LOCAL_REGISTRY:-} -eq 1 ]]; then
        builder push  --image-name "${IMAGE_NAME}" \
                      --img-flavor "${IMG_FLAVOR}" \
                      --image-tags "${DEFAULT_TAG}" \
                      --registry "${LOCAL_REGISTRY_ADR}" \
                      --extra-opts \
                      --compression-format "zstd" \
                      --compression-level 19 \
                      --tls-verify=false
    fi
done

readarray -t dangling_images < <(podman images -f "dangling=true" -q)
if [[ ${#dangling_images[@]} -gt 0 ]]; then
    echo ""
    log "INFO" "Removing dangling images..."
    podman rmi --force "${dangling_images[@]}"
    log "INFO" "Removed ${#dangling_images[@]} dangling images"
fi

