#!/bin/bash
source /usr/lib/catcat-os/funcvar.sh
source /etc/catcat-os/build_info

FREQ_UPDATE_FLATPAK_APPS=(
    "org.mozilla.firefox"
    "io.gitlab.librewolf-community"
    "net.mullvad.MullvadBrowser"
    "org.garudalinux.firedragon"
    "one.ablaze.floorp"
    "app.zen_browser.zen"
    "org.torproject.torbrowser-launcher"
    "org.chromium.Chromium"
    "com.brave.Browser"
    "io.github.ungoogled_software.ungoogled_chromium"
    "com.vivaldi.Vivaldi"
    "com.opera.Opera"
    "com.microsoft.Edge"
    "com.google.Chrome"
    "org.kde.falkon"
    "org.gnome.Epiphany"
    "re.sonny.Tangram"
)

FLATPAK_PATHS=("/var/lib/flatpak/app")
readarray -t FLATPAK_APPS < \
            <(find "${FLATPAK_PATHS[@]}" -maxdepth 1 -mindepth 1 -type d -printf "%f\n")

if check_network_connection; then
    for app in "${FREQ_UPDATE_FLATPAK_APPS[@]}"; do
        if [[ " ${FLATPAK_APPS[*]} " =~ " ${app} " ]]; then
            /usr/bin/flatpak update --assumeyes --noninteractive "${app}"
        fi
    done
fi
unset app

##########################################################################################

notify_all() {
    notify_users "/usr/share/pixmaps/catcat-os-logo.svg" "CatCat OS Update" "${1}" "${2}"
}

on_connection() {
    local conn_type="${1}" ssid connected_ssid

    if [[ "${conn_type}" =~ 'wifi=' ]]; then
        ssid="${conn_type#*=}"
        connected_ssid="$(nmcli -f IN-USE,ACTIVE,SSID dev wifi | grep "^\*.*yes")"
        [[ "${connected_ssid}" =~ "${ssid}" ]] && return 0
    elif [[ "$(nmcli -f TYPE connection show --active)" =~ "${conn_type}" ]]; then
        return 0
    else
        return 1
    fi
}

update_cmd() {
    local one_day=86400 one_week logfile firstboot_file
    one_week=$((one_day * 7))
    logfile="/etc/catcat-os/log/last-auto-update.log"
    firstboot_file="/etc/catcat-os/log/.first-boot-done"

    ensure_file "${logfile}" "${firstboot_file}"

    # Auto update if system is one week old
    if is_older_than "${logfile}" "${one_week}"; then
        if check_network_connection; then
            is_older_than "${firstboot_file}" "${one_week}" &&
                notify_all "Weekly automatic update has started."

            date "+%a %b %d %H:%M:%S %Y" > "${logfile}"

            /usr/bin/update extra >> "${logfile}"

            [[ ${BUILD_EPOCH} -lt $(( EPOCHSECONDS - one_week )) ]] &&
                 /usr/bin/update >> "${logfile}"

            is_older_than "${firstboot_file}" "${one_week}" &&
                notify_all "Weekly automatic update is done."
        fi
    fi
}


allowed_connection_file="/etc/catcat-os/auto_update_on_connection"

ensure_file "${allowed_connection_file}"

readarray -t connection_list < "${allowed_connection_file}"

if [[ ${#connection_list[@]} -gt 0 ]]; then
    for conn in "${connection_list[@]}"; do
        if on_connection "${conn}"; then
            log "INFO" "Network is active: ${conn}"
            log "INFO" "Performing updates"
            update_cmd
        else
            log "INFO" "Network is not active: ${conn}"
            log "INFO" "Skipping updates"
            continue
        fi
    done
else
    update_cmd
fi
