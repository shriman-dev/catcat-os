#!/bin/bash
source /usr/lib/catcat-os/funcvar.sh

runtimes() {
    local runtimes runtime runtime_vers ver
    runtimes=(
        "org.kde.KStyle.Kvantum"
        "org.freedesktop.Platform.VulkanLayer.vkBasalt"
        "org.freedesktop.Platform.VulkanLayer.gamescope"
        "org.freedesktop.Platform.VulkanLayer.MangoHud"
        "org.freedesktop.Platform.VulkanLayer.OBSVkCapture"
    )

    for runtime in "${runtimes[@]}"; do
        readarray -t runtime_vers < \
            <(flatpak search --columns=application,branch "${runtime}" | awk '{print $1 "//" $2}')
        for ver in "${runtime_vers[@]}"; do
            flatpak install "${SCOPE}" -y --noninteractive flathub "${ver}"
        done
    done
}

install_flatpaks() {
    source /etc/catcat-os/flatpak/pkgs-flatpak.sh
    #[[ $(ls -A1 /var/lib/flatpak/app/ | wc -l) -gt 1 ]]
    if check_network_connection; then
        log "INFO" "Installing system default flatpaks from flatpak list"
        # Add and set flathub
        flatpak remote-add "${SCOPE}" --if-not-exists \
                flathub "https://dl.flathub.org/repo/flathub.flatpakrepo"
        flatpak remote-modify "${SCOPE}" --prio=10 flathub
        flatpak install "${SCOPE}" -y --noninteractive \
                flathub "${DESKTOP_COMMON[@]}" "${DESKTOP_EXTRAS[@]}"
        runtimes
    fi
}

FLATPAK_PATHS=("/var/lib/flatpak/app")
[[ ${UID} -ne 0 ]] && FLATPAK_PATHS+=("${HOME}/.local/share/flatpak/app")
readarray -t FLATPAK_APPS < \
            <(find "${FLATPAK_PATHS[@]}" -maxdepth 1 -mindepth 1 -type d -printf "%f\n")

flapply_perms() {
    local msg="${1}"; shift
    local flags=() apps_array=() arg app

    for arg in "$@"; do
        { [[ "${arg}" == --* ]] && flags+=("${arg}"); } || apps_array+=("${arg}")
    done

    for app in "${apps_array[@]}"; do
        if [[ " ${FLATPAK_APPS[*]} " =~ " ${app} " ]]; then
            echo ""
            log "INFO" "${msg} for app: ${app}"
            flatpak override "${SCOPE}" "${flags[@]}" "${app}" || err "Failed to override perms"
        fi
    done
}

remove_filesystem_access() {
    local apps_array app metadata permitted_filesystem perms _perm
    apps_array=(
        "com.discordapp.Discord"
        "dev.vencord.Vesktop"
        "com.visualstudio.code"
        "com.spotify.Client"
        "org.videolan.VLC"
        "io.freetubeapp.FreeTube"
        "io.github.ryubing.Ryujinx"
        "net.lutris.Lutris"
        "com.usebottles.bottles"
        "com.valvesoftware.Steam"
        "com.heroicgameslauncher.hgl"
        "org.libretro.RetroArch"
        "net.pcsx2.PCSX2"
        "net.rpcs3.RPCS3"
        "org.mozilla.firefox"
        "io.gitlab.librewolf-community"
        "net.mullvad.MullvadBrowser"
        "org.garudalinux.firedragon"
        "one.ablaze.floorp"
        "app.zen_browser.zen"
        "org.torproject.torbrowser-launcher"
        "org.chromium.Chromium"
        "com.brave.Browser"
        "io.github.ungoogled_software.ungoogled_chromium"
        "com.vivaldi.Vivaldi"
        "com.opera.Opera"
        "com.microsoft.Edge"
        "com.google.Chrome"
        "org.kde.falkon"
        "re.sonny.Tangram"
    )

    for app in "${apps_array[@]}"; do
        if [[ " ${FLATPAK_APPS[*]} " =~ " ${app} " && \
                ! -f "/var/lib/flatpak/overrides/${app}" ]]; then
            log "INFO" "Remove existing filesystem permissions for app: ${app}"
            metadata="/var/lib/flatpak/app/${app}/current/active/metadata"
            permitted_filesystem="$(grep 'filesystems=' "${metadata}")" || true

            if [[ -n "${permitted_filesystem}" ]]; then
                perms=()
                permitted_filesystem="${permitted_filesystem#*=}"
                permitted_filesystem="${permitted_filesystem//;/ }"
                permitted_filesystem="${permitted_filesystem::-1}"
                for _perm in ${permitted_filesystem}; do
                    perms+=("--nofilesystem=${_perm%%:*}")
                done
                log "INFO" "Removing permissions: '${permitted_filesystem}'"
                flatpak override "${SCOPE}" "${perms[@]}" "${app}" || err "Failed to override perms"
            fi
        fi
  done
}

# secure flatpak apps
apply_global_restrictions() {
    log "INFO" "Restricting unnecessary permissions and allowing read-only permissions"
    flatpak override "${SCOPE}" \
            --unshare=ipc \
            --nosocket={{session,system}-bus,ssh-auth,pcsc,cups,gpg-agent,inherit-wayland-socket} \
            --nodevice={all,input,usb,kvm,shm} \
            --disallow={devel,multiarch,bluetooth,canbus,per-app-dev-shm} \
            --nofilesystem={host,host-{etc,os},home} \
            --filesystem={~/.{themes,icons}:ro,xdg-data/{icons,themes,fonts}:ro,xdg-config/{gtk-{3,4}.0,Kvantum,qt5ct}:ro} \
            --env=QT_STYLE_OVERRIDE=kvantum
#            --nofilesystem={~/.bash{rc,_profile},/home,/var,/var/{home,mnt,run,media},/run,/run/{media,udev},/media,/mnt}
}

allow_home() {
    local apps_array
    apps_array=(
        "app.fotema.Fotema"
        "com.github.neithern.g4music"
        "com.github.PintaProject.Pinta"
        "io.github.celluloid_player.Celluloid"
        "org.gnome.FileRoller"
        "org.gnome.Loupe"
        "org.gnome.meld"
        "org.gnome.Showtime"
        "org.libreoffice.LibreOffice"
        "org.onlyoffice.desktopeditors"
    )

    flapply_perms "Allowing home access" \
                  --unshare=network --filesystem=home \
                  "${apps_array[@]}"
}

allow_gpu_acceleration() {
    local apps_array
    apps_array=(
        "com.dec05eba.gpu_screen_recorder"
        "io.github.celluloid_player.Celluloid"
        "io.github.ilya_zlobintsev.LACT"
        "org.kde.krita"
        "org.pitivi.Pitivi"
        "org.shotcut.Shotcut"
        "org.gnome.Showtime"
        "org.upscayl.Upscayl"
        "org.videolan.VLC"
    )

    flapply_perms "Allowing gpu acceleration" \
                  --device=dri \
                  "${apps_array[@]}"
}

app_specific_perms() {
    # Allow all devices (cam) for camera apps
    flapply_perms "Allowing all devices (cam)" \
                  --unshare=network --device=all \
                  org.gnome.Cheese \
                  org.gnome.Snapshot

    # Enable kvm and gpu acceleration for virtualization apps
    flapply_perms "Enabling virtualization" \
                   --device={dri,kvm} \
                  org.gnome.Cheese \
                  org.gnome.Snapshot

    # Fix qt theme on wayland
    flapply_perms "To fix qt theme, disabling wayland socket" \
                  --nosocket=wayland \
                  org.videolan.VLC \
                  org.shotcut.Shotcut \
                  com.calibre_ebook.calibre \
                  net.pcsx2.PCSX2 \
                  net.rpcs3.RPCS3 \
                  org.libretro.RetroArch \
                  io.github.benjamimgois.goverlay

    # Allow host for LACT and GPU screen recorder
    flapply_perms "Allow host" \
                  --unshare=network --filesystem=host \
                  com.dec05eba.gpu_screen_recorder \
                  io.github.ilya_zlobintsev.LACT

    # Allow gedit to edit files all over system
    flapply_perms "Allow files to be edited anywhere on system" \
                  --unshare=network \
                  --filesystem={host,host-{etc,os},home} \
                  --filesystem={~/.local/share/{flatpak,libgedit-gtksourceview-300},~/.var,/tmp} \
                  org.gnome.gedit
}

# perms for gaming apps
configure_gaming_apps() {
    flapply_perms "Necessary gaming permissions" \
                  --device={input,dri} \
                  --allow={devel,multiarch,per-app-dev-shm} \
                  --filesystem=~/Me/Games \
                  --filesystem=xdg-config/{MangoHud:ro,vkBasalt:ro} \
                  --filesystem=xdg-data/{umu:create,Steam} \
                  --filesystem={~/.steam,~/.var/app/com.valvesoftware.Steam/data/Steam} \
                  --filesystem=xdg-data/Steam/compatibilitytools.d:create \
                  --env=DXVK_ASYNC=1 \
                  com.usebottles.bottles \
                  io.github.Faugus.faugus-launcher \
                  net.lutris.Lutri \
                  com.heroicgameslauncher.hgl \
                  io.github.benjamimgois.goverlay \
                  com.valvesoftware.Steam

    flapply_perms "Necessary gaming permissions" \
                  --nosocket=wayland \
                  --device={input,dri,kvm} \
                  --allow={devel,multiarch,per-app-dev-shm} \
                  --filesystem=~/Me/Games \
                  --filesystem=xdg-config/MangoHud:ro \
                  io.github.ryubing.Ryujinx \
                  org.libretro.RetroArch \
                  net.pcsx2.PCSX2 \
                  net.rpcs3.RPCS3

#    flapply_perms "Necessary gaming permissions" \
#                  --filesystem=xdg-run/gamescope-0:ro
#                  net.lutris.Lutris \
#                  com.heroicgameslauncher.hgl \
#                  io.github.ryubing.Ryujinx
}

show_help() {
    cat << EOF
Usage: $(basename "${0}") [options]

Options:
  -h, --help            Display this help message
  --system              Apply permissions system wide
  --user                Apply permissions for current user
  --install-all         Install default apps and runtimes system wide
  -a, --all             Apply all pre-configured permissions
  -g, --global          Apply restrictive permissions globally
  --allow-home          Allow access to home directory for certain apps
  --allow-gpu           Allow gpu acceleration for certain apps
  --app-specific        Apply app-specific permissions
  --gaming              Configure permissions for gaming apps
EOF
}

main() {
  if [[ $# -eq 0 ]]; then
    SCOPE="--system"
    grep 'devices=.*!all' "/var/lib/flatpak/overrides/global" | grep 'devices=.*!kvm' || {
        ensure_dir /var/lib/flatpak/overrides
        apply_global_restrictions
    }
  fi

  while [[ $# -gt 0 ]]; do
    case ${1} in
      -h|--help)
        show_help
        exit 0
        ;;
      --user|--system)
        SCOPE="${1}"
        ;;
      --install-all)
        install_flatpaks
        remove_filesystem_access
        ;;
      -a|--all)
        remove_filesystem_access
        apply_global_restrictions
        allow_home
        allow_gpu_acceleration
        app_specific_perms
        configure_gaming_apps
        ;;
      -g|--global)
        apply_global_restrictions
        ;;
      --allow-home)
        allow_home
        ;;
      --allow-gpu)
        allow_gpu_acceleration
        ;;
      --app-specific)
        app_specific_perms
        ;;
      --gaming)
        configure_gaming_apps
        ;;
      *)
        die "Unknown option: ${1}"
        ;;
    esac
    shift
  done
}

main "$@"

