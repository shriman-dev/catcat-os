#!/usr/bin/bash
source /usr/lib/catcat-os/funcvar.sh
# Default values
VERBOSE=
TMP_DIR="${TMP_DIR:-"/tmp/localdns-blocklist"}"
LOCALDNS_DATAD="${LOCALDNS_DATAD:-"/usr/share/catcat-os/localdns.d"}"
LOCALDNS_CONFD="${LOCALDNS_CONFD:-"/etc/catcat-os/localdns.d"}"
LOCALDNS_CONF="${LOCALDNS_CONFD}/config.json"
DNSCRYPT_CONFD='/etc/dnscrypt-proxy'
DNSMASQ_CONFD='/etc/dnsmasq.d'
DNSCRYPT_LOGD='/var/log/dnscrypt-proxy'
DNSMASQ_LOGD='/var/log'

DNS_BLOCKLIST_REPO="https://raw.githubusercontent.com/shriman-dev/dns-blocklist/refs/heads/main"

BACKEND_TYPE="dnscrypt"
LOG_RETENTION="3 months"

NM_OVERRIDE_CONF="/etc/NetworkManager/conf.d/localdns-server.conf"
NM_LOCALDNS_OVERRIDE='[main]
systemd-resolved=false
rc-manager=file

[global-dns-domain-*]
servers=127.0.0.1,::1'

write_config() {
    local key="${1}" value="${2}"
    local tmpfile="/tmp/localdns-config.tmp"

    jq --arg k "${key}" \
       --arg v "${value}" \
       '.[$k] = $v' \
       "${LOCALDNS_CONF}" > "${tmpfile}"

    mv ${VERBOSE:+-v} -f "${tmpfile}" "${LOCALDNS_CONF}"
}

load_config() {
    [[ -f "${LOCALDNS_CONF}" ]] || return 0
    local key value

    jq -r 'to_entries[] | "\(.key)=\(.value)"' "${LOCALDNS_CONF}" | \
    while IFS="=" read -r key value; do
        if [[ -v "${key^^}" ]]; then
            declare "${key^^}"="${value}"
        fi
    done
}

toggle_localdns() {
    local action="${1}" backend_service other_service force_now
    force_now=("--force" "--now")

    die_msg() { die "Failed to ${action} LocalDNS services"; }
    nm_restart() {
        # Always remove resolv.conf to prevent DNS leaks
        # (NM recreates it when restarted with override dns server)
        rm ${VERBOSE:+-v} -f /etc/resolv.conf 2>/dev/null || true
        systemctl daemon-reload && systemctl restart NetworkManager.service
    }

    case "${BACKEND_TYPE}" in
        dnscrypt)
            backend_service="dnscrypt-proxy.service"
            other_service="dnsmasq.service"
            ;;
        dnsmasq)
            backend_service="dnsmasq.service"
            other_service="dnscrypt-proxy.service"
            ;;
        *)  die "Unknown argument: ${BACKEND_TYPE}";;
    esac

    # Behavior inside ostree build env
    if [[ -d "${LOCALDNS_DATAD}" && -w "${LOCALDNS_DATAD}" ]]; then
        log "INFO" "Operating inside ostree build env..."
        # Do not force now action when inside build env
        force_now=()
        # Disable Network Manager restart
        nm_restart() { true; }
    else
        # Normal behavior
        # Ensure NM dns server override conf
        ensure_dir "$(dirname "${NM_OVERRIDE_CONF}")"
        [[ ! -f "${NM_OVERRIDE_CONF}" ]] && {
            printf "%s\n" "${NM_LOCALDNS_OVERRIDE}" | tee "${NM_OVERRIDE_CONF}" || die_msg; }
        # Ensure blocklists so backend service does not fail to start
        ensure_file "${DNSCRYPT_CONFD}/domains-blocklist.txt" \
                    "${DNSMASQ_CONFD}/domains-blocklist.conf"
    fi

    # Disable other backend beforehand
    systemctl -q is-enabled "${other_service}" &&
        { systemctl disable "${force_now[@]}" "${other_service}" || die_msg; }

    case "${action}" in
        enable)
            log "INFO" "Enabling LocalDNS..."
            systemctl enable "${force_now[@]}" \
                      "${backend_service}" \
                      dns-blocklist-updater.timer || die_msg
            nm_restart || die_msg
            ;;
        disable)
            log "INFO" "Disabling LocalDNS..."
            rm ${VERBOSE:+-v} -f "${NM_OVERRIDE_CONF}" || die_msg
            systemctl disable "${force_now[@]}" \
                      "${backend_service}" \
                      dns-blocklist-updater.timer || die_msg
            nm_restart || die_msg
            ;;
        restart)
            log "INFO" "Restarting LocalDNS services..."
            systemctl restart "${backend_service}" || die_msg
            ;;
        *)
            die "Invalid service action. Use 'enable', 'disable', or 'restart'"
            ;;
    esac
    log "INFO" "Operation completed successfully"
}

update_blocklist() {
    local src_file dst_file blocklist_archive
    log "INFO" "Updating LocalDNS blocklist (Backend: ${BACKEND_TYPE})"

    ensure_dir "${TMP_DIR}"

    case "${BACKEND_TYPE}" in
        dnscrypt)
            src_file="domains-filtered-subdomains"
            dst_file="${DNSCRYPT_CONFD}/domains-blocklist.txt"
            blocklist_archive="${DNS_BLOCKLIST_REPO}/domains.d/${src_file}.tar.zst"
            ;;
        dnsmasq)
            src_file="blocklist.conf"
            dst_file="${DNSMASQ_CONFD}/domains-blocklist.conf"
            blocklist_archive="${DNS_BLOCKLIST_REPO}/dnsmasq.d/${src_file}.tar.zst"
            ;;
        *)  die "Unknown argument: ${BACKEND_TYPE}";;
    esac

    log "INFO" "Downloading blocklist..."
    curl_get "${TMP_DIR}/${src_file}.tar.zst" "${blocklist_archive}" ||
        die "Failed to download blocklist"

    log "INFO" "Extracting blocklist..."
    unarchive "${TMP_DIR}/${src_file}.tar.zst" "${TMP_DIR}" ||
        die "Failed to extract blocklist"

    cp ${VERBOSE:+-v} -f "${TMP_DIR}/${src_file}" "${dst_file}" ||
        die "Failed to update blocklist"
    rm -rf "${TMP_DIR}"

    toggle_localdns restart
    log "INFO" "Blocklist update completed successfully"
}

switch_backend() {
    local backend="${1}"

    ensure_dir "${LOCALDNS_CONFD}"
    case "${backend,,}" in
        dnscrypt|dnsmasq)
            BACKEND_TYPE="${backend,,}"
            [[ -f "${LOCALDNS_CONF}" ]] &&
                write_config "backend_type" "${BACKEND_TYPE}"
            log "INFO" "Switched to ${BACKEND_TYPE} backend"
            log "INFO" "Update blocklist to make changes take effect"
            ;;
        *)
            die "Invalid backend. Use 'dnscrypt' or 'dnsmasq'"
            ;;
    esac
}

# Log functions
clean_old_logs() {
    if [[ -n "$*" ]]; then
        local input="$*"
        local digits="${input//[^0-9]/}"
        if [[ "${input}" =~ ^[[:alnum:][:space:]]+$ && "${digits}" =~ ^[0-9]{1,2}$ ]]; then
            LOG_RETENTION="${input}"
            [[ -f "${LOCALDNS_CONF}" ]] &&
                write_config "log_retention" "${LOG_RETENTION}"
        else
            die "Invalid input for log_retention"
        fi
    fi

    log "INFO" "Cleaning logs older than ${LOG_RETENTION}"

    local dnscrypt_date_format dnsmasq_date_format date_format log_file line
    dnscrypt_date_format="$(date -d "-${LOG_RETENTION}" '+%Y-%m-%d')"
    dnsmasq_date_format="$(date -d "-${LOG_RETENTION}" '+%b %d')"

    [[ -z "${dnscrypt_date_format}" || -z "${dnsmasq_date_format}" ]] &&
        die "Could not parse date with LOG_RETENTION='${LOG_RETENTION}'"

    # Clean logs
    for log_file in "${DNSMASQ_LOGD}/dnsmasq.log" "${DNSCRYPT_LOGD}"/*.log; do
        if [[ -f "${log_file}" ]]; then
            if [[ ${log_file} == *"${DNSCRYPT_LOGD}"* ]]; then
                date_format="${dnscrypt_date_format}"
            else
                date_format="${dnsmasq_date_format}"
            fi

            line=$(rg -n "${date_format}" "${log_file}" | cut -d: -f1 | tail -n1)
            log "DEBUG" "Clean logs before '${date_format}' in log file: ${log_file}"
            log "DEBUG" "From line: ${line:-0}"
            if [[ -n "${line}" ]]; then
                sed -i "1,${line} d" "${log_file}" || die "Log cleanup failed: ${log_file}"
            else
                log "DEBUG" "No logs before '${date_format}' in log file: ${log_file}"
            fi
        fi
    done

    log "INFO" "Log cleanup completed"
}

setup_localdns() {
    local src_file dst_file blocklist_archive
    local store_dir store_archive

    log "INFO" "Starting LocalDNS setup..."

    case "${BACKEND_TYPE}" in
        dnscrypt)
            src_file="domains-filtered-subdomains"
            dst_file="${DNSCRYPT_CONFD}/domains-blocklist.txt"
            blocklist_archive="${DNS_BLOCKLIST_REPO}/domains.d/${src_file}.tar.zst"
            ;;
        dnsmasq)
            src_file="blocklist.conf"
            dst_file="${DNSMASQ_CONFD}/domains-blocklist.conf"
            blocklist_archive="${DNS_BLOCKLIST_REPO}/dnsmasq.d/${src_file}.tar.zst"
            ;;
        *)  die "Unknown argument: ${BACKEND_TYPE}";;
    esac

    ensure_dir "${LOCALDNS_CONFD}" "${TMP_DIR}"
    check_file_inplace "${DNSCRYPT_CONFD}/dnscrypt-proxy.toml" \
                       "${DNSMASQ_CONFD}/defaults.conf" \
                       "${DNSMASQ_CONFD}/dns-defaults.conf"

    # Store blocklist
    store_dir="${LOCALDNS_DATAD}/${BACKEND_TYPE}"
    store_archive="${store_dir}/$(basename "${blocklist_archive}")"
    if [[ ! -d "${store_dir}" && -w "/usr/share" ]]; then
        # Clear anything inside LOCALDNS_DATAD
        # For configured backend's blocklist archive to be added
        [[ -d "${LOCALDNS_DATAD}" ]] && rm -rvf "${LOCALDNS_DATAD:?}"/*

        ensure_dir "${store_dir}"
        # Disable and mask systemd-resolved
        systemctl disable systemd-resolved.service || err "systemd-resolved"
        systemctl mask systemd-resolved.service || err "systemd-resolved"
        # Ensure dnsmasq is configured to read DNSMASQ_CONFD
        grep -qxF "conf-dir=${DNSMASQ_CONFD}/,*.conf" /etc/dnsmasq.conf ||
            { echo "conf-dir=${DNSMASQ_CONFD}/,*.conf" >> /etc/dnsmasq.conf ||
                die "Failed to configure dnsmasq.conf"; }

        toggle_localdns enable

        # Check if blocklist archive is cached
        if [[ ! -f "${TMP_DIR}/${src_file}.tar.zst" ]]; then
            curl_get "${TMP_DIR}/${src_file}.tar.zst" "${blocklist_archive}" ||
                die "Failed to download blocklist"
        else
            log "NOTE" "Blocklist archive is cached"
        fi
        split -dC 5M "${TMP_DIR}/${src_file}.tar.zst" "${store_archive}" ||
            die "Failed to split blocklist"
    fi

    # Retore blocklist
    if [[ -d "${store_dir}" && ! -w "${store_dir}" ]]; then
        [[ ! -d "/var/log/dnscrypt-proxy" || ! -d "/var/cache/dnscrypt-proxy" ]] && {
            ensure_dir "/var/log/dnscrypt-proxy" "/var/cache/dnscrypt-proxy"
            chmod -v 700 "/var/log/dnscrypt-proxy" "/var/cache/dnscrypt-proxy"
        }

        if [[ ! -f "${dst_file}" ]]; then
            { cat "${store_archive}"* | tar -C "${TMP_DIR}"/ --zstd -xvf - &&
                cp ${VERBOSE:+-v} -f "${TMP_DIR}/${src_file}" "${dst_file}"; } ||
                    err "Failed to place stored blocklist archive"
        fi

        restorecon -vR "${DNSMASQ_CONFD}"/

        { rm ${VERBOSE:+-v} -f /etc/resolv.conf &&
            toggle_localdns restart &&
            systemctl restart NetworkManager.service
        } || err "Failed to initiate localdns"
    fi
    rm ${VERBOSE:+-v} -rf "${TMP_DIR}"
    log "INFO" "LocalDNS setup done"
}

RG_BASE="--line-buffered --passthru --color=always"
RG_BLUE="${RG_BASE} --colors match:fg:blue"
RG_YELLOW="${RG_BASE} --colors match:fg:yellow"
RG_RED="${RG_BASE} --colors match:fg:red"
RG_RED_BG_BLACK="${RG_RED} --colors match:bg:black"

dnsmasq_logs() {
    local path="${DNSMASQ_LOGD}" show_lines=${SHOW_LINES:-5999}
    local base_cmd="tail -n ${show_lines} -f"
    local log_file="${path}/dnsmasq.log" filter_cmd log_format="log"

    local common_pattern='DNS-rebind| ::$|0\.0\.0\.0|NXDOMAIN|HINFO|REFUSED|SERVFAIL'
    local nxdata_pattern=': .*NXDOMAIN|NODATA.*|reply.*truncated'
    local reject_pattern=': .*DNS-rebind.*|: .* ::$|: .*0\.0\.0\.0|config.*NXDOMAIN|: .*HINFO.*'
    local error_pattern=': .*REFUSED.*|: .*SERVFAIL.*'

    case "${1}" in
        detailed)
            filter_cmd="rg ${RG_YELLOW} \"${nxdata_pattern}\" | \
                        rg ${RG_RED} \"${reject_pattern}\" | \
                        rg ${RG_RED_BG_BLACK} \"${error_pattern}\""
            ;;
        queries)
            filter_cmd="rg --color=never -i \"query|NODATA|${common_pattern}\" | \
                        rg ${RG_YELLOW} \"${nxdata_pattern}\" | \
                        rg ${RG_RED} \"${reject_pattern}\" | \
                        rg ${RG_RED_BG_BLACK} \"${error_pattern}\""
            ;;
        blocked)
            filter_cmd="rg --color=never -i \"${common_pattern}\" | \
                        rg ${RG_YELLOW} \"${nxdata_pattern}\" | \
                        rg ${RG_RED} \"${reject_pattern}\" | \
                        rg ${RG_RED_BG_BLACK} \"${error_pattern}\""
            ;;
        *)
            die "Invalid log type: ${1}"
            ;;
    esac

    [[ ! -f "${log_file}" ]] && die "Log file not found: ${log_file}"

    # Execute the command pipeline
    ${base_cmd} "${log_file}" | eval "${filter_cmd}" | bat --paging=never -nl "${log_format}"
}

dnscrypt_logs() {
    local path="${DNSCRYPT_LOGD}" show_lines=${SHOW_LINES:-999}
    local base_cmd="tail -n ${show_lines} -f"
    local log_file filter_cmd log_format="csv"

    case "${1}" in
        queries)
            log_file="${path}/query.log"
            filter_cmd="rg ${RG_YELLOW} 'NXDOMAIN|NODATA|SYNTH' | \
                        rg ${RG_RED} '\t.*REJECT|NOT_READY|NETWORK_ERROR|SERVER_TIMEOUT|' | \
                        rg ${RG_RED_BG_BLACK} '\t.*REFUSED.*|\t.*SERVFAIL.*|\t.*RESPONSE_ERROR.*'"
            ;;
        blocked)
            log_file="${path}/blocked-domains.log"
            filter_cmd="rg ${RG_YELLOW} '\(alias.*' | rg ${RG_BLUE} '\*\.'"
            ;;
        allowed)
            log_file="${path}/allowed-domains.log"
            filter_cmd="rg ${RG_YELLOW} '\(alias.*' | rg ${RG_BLUE} '\*\.'"
            ;;
        blocked-ips)
            log_file="${path}/blocked-ips.log"
            ;;
        allowed-ips)
            log_file="${path}/allowed-ips.log"
            ;;
        nxdomains)
            log_file="${path}/nx.log"
            ;;
        launch)
            log_file="${path}/dnscrypt-proxy.log"
            filter_cmd="rg ${RG_YELLOW} 'Stopped.' | \
                        rg ${RG_BLUE} 'dnscrypt-proxy .*\..*\..*'"
            log_format="log"
            ;;
        *)
            die "Invalid log type: ${1}"
            ;;
    esac

    [[ ! -f "${log_file}" ]] && die "Log file not found: ${log_file}"

    # Execute the command pipeline
    if [[ -n "${filter_cmd}" ]]; then
        ${base_cmd} "${log_file}" | eval "${filter_cmd}" | bat --paging=never -nl "${log_format}"
    else
        ${base_cmd} "${log_file}" | bat --paging=never -nl "${log_format}"
    fi
}

show_log() {
    local log_type="${1}"

    # Build bat cache so log viewing does not fail
    bat /etc/dnsmasq.d/defaults.conf >/dev/null 2>&1 || bat cache --build >/dev/null 2>&1

    case "${log_type}" in
        dnsmasq-*) dnsmasq_logs "${log_type#dnsmasq-}" ;;
        dnscrypt-*) dnscrypt_logs "${log_type#dnscrypt-}" ;;
        *) die "Invalid log type specified: ${log_type}" show_help ;;
    esac
}

show_help() {
    cat <<EOF
Usage: $(basename "${0}") [OPTIONS]
Configure and manage DNS to block Ad/Malware using blocklist or monitor DNS logs with localdns

Options:
  -h, --help                Show this help message
  -v, --verbose             Enable verbose output
  -u, --update              Update DNS blocklist
  --enable                  Enable localdns
  --disable                 Disable localdns
  --restart                 Restart localdns
  --switch-backend BACKEND  Change blocklist backend 'dnsmasq|dnscrypt'

Log Options:
  --flush-logs TIME         Remove logs older than TIME
                            TIME format: N 'day(s)|week(s)|month(s)|year(s)' (default: 3 months)
  -n, --lines NUMBER        Show last N lines of log (default: 5999)
  -l, --log TYPE            Specify log type to display

Log types:
  dnsmasq-detailed          Show detailed DNSMasq logs
  dnsmasq-queries           Show DNSMasq queries
  dnsmasq-blocked           Show blocked DNSMasq queries
  dnscrypt-queries          Show DNSCrypt queries
  dnscrypt-blocked          Show blocked DNSCrypt queries
  dnscrypt-allowed          Show allowed DNSCrypt queries
  dnscrypt-blocked-ips      Show blocked IPs in DNSCrypt
  dnscrypt-allowed-ips      Show allowed IPs in DNSCrypt
  dnscrypt-nxdomains        Show DNSCrypt NXDOMAIN responses
  dnscrypt-launch           Show DNSCrypt launch logs
EOF
}

[[ $# -eq 0 ]] && die "No options provided" show_help
[[ "$*" =~ (-h|--help) ]] && show_help && exit 0

need_root
load_config
while [[ $# -gt 0 ]]; do
    case ${1} in
        -v|--verbose)
            VERBOSE=3
            shift
            ;;
        --setup)
            setup_localdns
            shift
            ;;
        -u|--update)
            update_blocklist
            shift
            ;;
        --enable|--disable|--restart)
            toggle_localdns "${1:2}"
            shift
            ;;
        --switch-backend)
            [[ -n "${2}" ]] || die "Backend type required (dnsmasq|dnscrypt)"
            switch_backend "${2}"
            shift 2
            ;;
        --flush-logs)
            shift
            clean_old_logs "$*"
            break
            ;;
        -n|--lines)
            [[ "${2}" =~ ^[0-9]+$ ]] || die "Requires number of lines to show"
            SHOW_LINES="${2}"
            shift 2
            ;;
        -l|--log)
            [[ -n "${2}" ]] || die "Log type required" show_help
            show_log "${2}"
            shift 2
            ;;
        *)
            die "Unknown option: ${1}" show_help
            ;;
    esac
done

