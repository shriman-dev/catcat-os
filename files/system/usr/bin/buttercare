#!/usr/bin/bash
source /usr/lib/catcat-os/funcvar.sh

VERBOSE=

# Get all BTRFS mount points
get_btrfs_mounts() {
    lsblk -lno MOUNTPOINT --filter 'FSTYPE == "btrfs"'
}

# Show filesystem usage
show_btrfs_usage() {
    local path="${1}"
    validate_path "btrfs" "${path}"
    log "INFO" "Showing BTRFS detailed usage for ${path}"
    ${BTRFS} filesystem usage "${path}"
    echo
    log "INFO" "Showing BTRFS disk space for ${path}"
    ${BTRFS} filesystem df "${path}"
}

# Perform balance operation
balance() {
    local path="all" musage=50 dusage=80
    while [[ $# -gt 0 ]]; do
        case "${1}" in
            -m) musage="${2}"; shift ;;
            -d) dusage="${2}"; shift ;;
            -p) path="${2}";   shift ;;
            *) die "Invalid balance option: ${1}" ;;
        esac
        shift
    done

    local mounts=("${path}")
    if [[ "${path}" == "all" ]]; then
        log "INFO" "Auto detecting BTRFS mount points"
        mounts=($(get_btrfs_mounts))
        log "INFO" "Mount points detected: ${mounts[@]}"
    fi

    btrfs_df() {
        log "INFO" "${1} disk space usage (btrfs filesystem df):"
        ${BTRFS} filesystem df "${_mount}"
    }

    local _mount
    for _mount in ${mounts[@]}; do
        validate_path "btrfs" "${_mount}"
        log "INFO" "Starting balance on ${_mount}"
        [[ -n ${VERBOSE} ]] && btrfs_df "Pre-balance"
        echo ""
        ${BTRFS} balance start -musage="${musage}" -dusage="${dusage}" --enqueue "${_mount}"
        echo ""
        [[ -n ${VERBOSE} ]] && btrfs_df "Post-balance"
        log "INFO" "Balance completed for ${_mount}"
    done
}

# Perform defragmentation
defrag() {
    local path comp level
    while [[ $# -gt 0 ]]; do
        case "${1}" in
            -c) comp="${2}"; shift ;;
            -l) level=${2};  shift ;;
            -p) path="${2}"; shift ;;
            *) die "Invalid defrag option: ${1}" ;;
        esac
        shift
    done
    [[ -z ${comp} || -z ${path} ]] && die "Both compression (-c) and path (-p) are required for defrag"

    validate_path "btrfs" "${path}"

    log "INFO" "Starting defragmentation on ${path} (compression: ${comp}${level:+, level: ${level}})"
    ${BTRFS} filesystem defragment -r -c"${comp}" ${level:+-L ${level}} "${path}"
    log "INFO" "Defragmentation completed for ${path}"
}

# Perform scrub operation
scrub() {
    local path="${1}"
    validate_path "btrfs" "${path}"
    log "INFO" "Starting scrub on ${path}"
    ${BTRFS} scrub start -B "${path}"
    log "INFO" "Scrub completed for ${path}"
}


# Perform TRIM operation
trim() {
    local path="${1:-}"
    if [[ -z "${path}" ]]; then
        log "INFO" "Running TRIM on fstab entries"
        ${FSTRIM} --fstab
        log "INFO" "TRIM completed on fstab entries"
    else
        log "INFO" "Running TRIM on ${path}"
        ${FSTRIM} "${path}"
        log "INFO" "TRIM completed on ${path}"
    fi
}

show_help() {
    cat <<EOF
Usage: $(basename "${0}") [global_options] command1 [options] [command2 [options] ..."

Global Options:
  -h, --help              Show this help message
  -v, --verbose           Enable verbose output (use -vv for debug verbosity)

Commands:
  usage  <path>           Show BTRFS filesystem usage and disk space information

  balance                 Start balance operation on BTRFS filesystem
                          Note: Balance operation auto detects all BTRFS mount points if no path specified
                          Options: -m [musage] -d [dusage] -p [path|all] (Defaults: musage=50, dusage=80, path=all)

  defrag                  Defragment the BTRFS filesystem using a specified compression algorithm
                          Options: -c <algorithm> -l [level] -p <path>

  scrub  <path>           Start a scrub operation on BTRFS filesystem

  trim   [path]           Perform TRIM operation on the path
                          Note: TRIM operation uses fstab entries if no path specified
EOF
}

exec_subcommand() {
    need_root
    BTRFS="$(echo 'btrfs' ${VERBOSE:+-v})"
    FSTRIM="$(echo 'fstrim' ${VERBOSE:+-v})"
    local cmd="${1}"; shift
    case "${cmd}" in
        usage) [[ $# -eq 1 ]] && show_btrfs_usage "${1}" ||
                   die "BTRFS mount path required to show usage"
            ;;
        defrag) defrag "$@"
            ;;
        balance) balance "$@"
            ;;
        scrub) [[ $# -eq 1 ]] && scrub "${1}" ||
                   die "BTRFS mount path required for scrub"
            ;;
        trim) [[ $# -le 1 ]] && trim  "$@" ||
                  die "Usage: $(basename ${0}) trim [PATH]"
            ;;
        *) die "Unknown command: ${cmd}" show_help
            ;;
    esac
}

main() {
    local rem_args arg curr_cmd curr_args

    [[ $# -eq 0 ]] && show_help
    # Iterate through all arguments and capture global flags
    rem_args=()
    while [[ $# -gt 0 ]]; do
        case "${1}" in
            -h|--help)
                show_help;         exit 0 ;;
            -v|--verbose)
                VERBOSE=1;          shift ;;
            -vv)
                VERBOSE=2;          shift ;;
            *)
                rem_args+=("${1}"); shift ;;
        esac
    done

    # Execute subcommands
    for arg in "${rem_args[@]}"; do
        case "${arg}" in
            usage|balance|defrag|scrub|trim)
                # Execute a subcommand in progress before starting new one
                if [[ -n "${curr_cmd:-}" ]]; then
                    exec_subcommand "${curr_cmd}" "${curr_args[@]}"
                fi
                curr_cmd="${arg}"
                curr_args=()
                ;;
            *)
                # Collect args for active subcommand
                if [[ -n "${curr_cmd:-}" ]]; then
                    curr_args+=("${arg}")
                else
                    die "Non glabl flag '${arg}' provided before subcommand"
                fi
                ;;
        esac
    done

    # Execute the final subcommand remaining
    if [[ -n "${curr_cmd:-}" ]]; then
        exec_subcommand "${curr_cmd}" "${curr_args[@]}"
    fi
}

main "$@"
